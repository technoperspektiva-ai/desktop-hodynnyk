{
  "name": "desktop-hodynnyk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "bun run build",
    "dev": "vite",
    "build": "bun run provision:r2 && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "provision:r2": "wrangler r2 bucket create desktop-hodynnyk-user-assets || echo \"R2 bucket already exists or is already provisioned\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.131.0",
    "@cloudflare/workers-types": "^5.20260911.1"
  }
}
