{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "desktop-hodynnyk",
  "compatibility_date": "2026-09-11",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/user-assets/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "desktop-hodynnyk"
    }
  ],
  "r2_buckets": [
    {
      "binding": "USER_ASSETS",
      "bucket_name": "desktop-hodynnyk-user-assets"
    }
  ]
}
